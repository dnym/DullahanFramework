sfx synthwave_loop bpm=124 bars=4 bpb=4 sr=44100 ch=2 loop=1 xfade=0.025 curve=lin norm=-3 seed=7

def kick
  osc sin 55 penv=155>42:0.085:exp env=0.002,0.19,0,0.02 g=0.95
  noi white env=0.001,0.014,0,0.005 g=0.22 | flt hp 1800
end

def snare
  osc tri 195 penv=230>135:0.06:exp env=0.002,0.11,0,0.02 g=0.55
  noi pink env=0.002,0.18,0,0.04 g=0.65 | flt bp 1600 q=0.7 | drv 0.25
end

def hat
  noi white env=0.001,0.045,0,0.01 g=0.24 | flt hp 7200
end

def bass
  osc saw 55 env=0.004,0.16,0.35,0.04 g=0.58 | flt lp 950 q=1.8 | drv 0.20
end

def arp
  ssaw 440 v=3 det=9 spr=0.7 env=0.004,0.14,0.15,0.06 g=0.28 | flt lp 2800 q=1.1
end

pat kick  "X...X...X...X..." step=0.25 rep=4 g=0.92
pat snare "....X.......X..." step=0.25 rep=4 g=0.72 | rev room=0.45 mix=0.28 damp=0.5
pat hat   "..x...x...x...x." step=0.25 rep=4 g=0.52 pan=0.18

seq bass "A1:.5 A1:.5 A1:.5 A1:.5 A1:.5 A1:.5 A1:.5 A1:.5 F1:.5 F1:.5 F1:.5 F1:.5 F1:.5 F1:.5 F1:.5 F1:.5 C2:.5 C2:.5 C2:.5 C2:.5 C2:.5 C2:.5 C2:.5 C2:.5 G1:.5 G1:.5 G1:.5 G1:.5 G1:.5 G1:.5 E1:.5 G1:.5" gate=0.82 g=0.85

seq arp "A3:.5 C4:.5 E4:.5 A4:.5 E4:.5 C4:.5 A3:.5 E4:.5 F3:.5 A3:.5 C4:.5 F4:.5 C4:.5 A3:.5 F3:.5 C4:.5 C4:.5 E4:.5 G4:.5 C5:.5 G4:.5 E4:.5 C4:.5 G4:.5 G3:.5 B3:.5 D4:.5 G4:.5 D4:.5 B3:.5 G3:.5 D4:.5" gate=0.75 g=0.62 | dly b=0.75 mix=0.26 fb=0.32 damp=3500 pp=1 | rev room=0.6 mix=0.22

bus | flt hp 32 | cmp thr=-10 rat=3.0 atk=0.008 rel=0.12 | wid 1.15
