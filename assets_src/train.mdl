box neon_magenta -1.15,1.10,0 0.05,0.14,10.2 a=c
box neon_magenta 1.15,1.10,0 0.05,0.14,10.2 a=c
box neon_cyan -1.15,1.90,0 0.05,0.42,8.8 a=c
box neon_cyan 1.15,1.90,0 0.05,0.42,8.8 a=c
# Roof deck trim & walkable cyan guide rails (Y=2.85)
box deck_dark 0,2.82,0 2.02,0.08,10.2 a=b bev=0.02
box neon_cyan -0.96,2.88,0 0.07,0.06,10.0 a=c
box neon_cyan 0.96,2.88,0 0.07,0.06,10.0 a=c
box hull_slate 0,2.86,-3.2 1.35,0.14,1.6 a=b bev=0.03
box hull_slate 0,2.86,2.2 1.35,0.14,1.6 a=b bev=0.03
# Rear taillights (-Z)
box neon_orange -0.68,1.05,-5.32 0.46,0.24,0.06 a=c
box neon_orange 0.68,1.05,-5.32 0.46,0.24,0.06 a=c
